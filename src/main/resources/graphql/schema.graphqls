type Query {
    productionUnits: [ProductionUnit!]!
    cycles(status: String): [Cycle!]!

    # Katalogi ya kimfumo - inahitajika kujaza speciesId ya CreateCycleInput
    species: [Species!]!

    # ---------- Feed ----------
    feedPurchases: [FeedPurchase!]!
    feedingLogs(cycleId: Int): [FeedingLog!]!
    feedStockMovements: [FeedStockMovement!]!
    feedStockBalance: Float!

    # ---------- Water Quality ----------
    # Bila hoja: vipimo vya shamba zima. unitId: tanki moja. cycleId:
    # vipimo vya tanki analomoendeshea mzunguko huo (jedwali halina
    # cycle_id - angalia WaterQualityService).
    waterQualityLogs(unitId: Int, cycleId: Int): [WaterQualityLog!]!

    # ---------- Daily Tasks ----------
    # Kazi ZOTE za mzunguko kwa siku moja, kila moja ikiwa na `done` yake.
    # `date` ikiachwa wazi ni leo. Huu ndio mkataba unaosomwa na Reminders -
    # angalia DailyTaskStatus hapo chini.
    dailyTasks(cycleId: Int!, date: String): [DailyTaskStatus!]!
}

type Mutation {
    createProductionUnit(input: CreateProductionUnitInput!): ProductionUnit!
    createCycle(input: CreateCycleInput!): Cycle!

    # ---------- Feed ----------
    recordFeedPurchase(input: RecordFeedPurchaseInput!): FeedPurchase!
    logFeeding(input: LogFeedingInput!): FeedingLog!

    # ---------- Water Quality ----------
    logWaterQuality(input: LogWaterQualityInput!): WaterQualityLog!

    # ---------- Daily Tasks ----------
    completeTask(input: CompleteTaskInput!): DailyTaskStatus!
}

type ProductionUnit {
    unitId: ID!
    code: String!
    type: String!
    sizeM3: Float
    waterSource: String
    status: String!
}

input CreateProductionUnitInput {
    code: String!
    type: String!
    sizeM3: Float
    waterSource: String
}

# Aina ya samaki. Ni katalogi ya kimfumo (haina farm_id) - inasomwa tu;
# hakuna mutation ya kuunda/kuhariri kwa makusudi.
type Species {
    speciesId: ID!
    name: String!
    # Miezi ya wastani hadi mavuno - ndiyo inayokokotoa expectedHarvestDate
    growthMonthsAvg: Float!
    avgHarvestWeightKg: Float!
}

type Cycle {
    cycleId: ID!
    unit: ProductionUnit!
    speciesName: String!
    stockingDate: String!
    fingerlingsCount: Int!
    survivalRateEstimate: Float!
    expectedHarvestDate: String
    actualHarvestDate: String
    status: String!
}

input CreateCycleInput {
    unitId: ID!
    speciesId: ID!
    stockingDate: String!
    fingerlingsCount: Int!
    survivalRateEstimate: Float
}

# ============================================================
# Feed — ununuzi, ulishaji, na leja ya stoo
# ============================================================

type FeedPurchase {
    purchaseId: ID!
    purchaseDate: String!
    feedType: String!
    quantityKg: Float!
    unitCost: Float!
    # Inakokotolewa na database (GENERATED ALWAYS) - si sehemu ya input
    totalCost: Float
    supplier: String
}

input RecordFeedPurchaseInput {
    purchaseDate: String!
    feedType: String!
    quantityKg: Float!
    unitCost: Float!
    supplier: String
}

type FeedingLog {
    logId: ID!
    cycle: Cycle!
    logDate: String!
    feedType: String
    quantityKg: Float!
    recordedByName: String
}

input LogFeedingInput {
    cycleId: Int!
    # Ikiachwa wazi, inatumia leo
    logDate: String
    feedType: String
    quantityKg: Float!
}

# Leja inayozalishwa na mfumo: kununua -> IN, kulisha -> OUT.
# Haiandikwi moja kwa moja na mteja (angalia FeedService).
type FeedStockMovement {
    movementId: ID!
    direction: String!
    quantityKg: Float!
    referencePurchaseId: Int
    referenceFeedingLogId: Int
    movedAt: String!
}

# ============================================================
# Water Quality — vipimo vya maji kwenye kitengo
#
# Kipimo ni cha KITENGO, si cha mzunguko (water_quality_logs.unit_id):
# maji ni mali ya tanki, si ya samaki walioko ndani yake msimu huu.
#
# Vipimo vyote vinne vinaweza kuwa null - mtu mwenye kipima-pH pekee
# anarekodi pH, na kuacha nyingine wazi ni sahihi zaidi kuliko sifuri.
#
# THAMANI MBAYA INAKUBALIWA. Oksijeni 0.8, pH 4.2, amonia 0.9 - hizi
# ndizo sababu ya kupima, na amonia ndiyo chanzo kikuu cha vifo vya
# ghafla. Kinachokataliwa ni kisichowezekana kimuundo pekee: pH nje ya
# 0-14, oksijeni au amonia hasi (angalia WaterQualityService).
# ============================================================

type WaterQualityLog {
    logId: ID!
    unit: ProductionUnit!
    logDate: String!
    # 0.0 - 14.0
    ph: Float
    # Nyuzi Selsiasi
    temperature: Float
    # Oksijeni iliyoyeyuka (DO), mg/L
    oxygen: Float
    # Amonia jumla (NH3 + NH4+), mg/L. Desimali mbili: 0.02 ni salama,
    # 0.25 inaua polepole.
    ammonia: Float
    notes: String
    recordedByName: String
}

input LogWaterQualityInput {
    unitId: Int!
    # Ikiachwa wazi, inatumia leo
    logDate: String
    ph: Float
    temperature: Float
    oxygen: Float
    ammonia: Float
    notes: String
}

# ============================================================
# Daily Tasks — kazi za kila siku na ukamilishaji wake
#
# `daily_tasks` ni KIOLEZO kinachojirudia (frequency=DAILY,
# scheduled_time ni saa ya siku, hakuna tarehe ya mwisho). Hivyo
# "imekamilika" si bendera juu ya kiolezo - ingekuwa kweli milele baada
# ya siku ya kwanza - bali ni REKODI ya `task_completions`, moja kwa
# (kiolezo, tarehe), kama UNIQUE(task_id, completion_date) ya V1
# inavyolazimisha.
#
# MKATABA WA REMINDERS, na ndiyo sababu type hii ipo:
#
#     done = kuna rekodi ya (task_id, tarehe) yenye status DONE
#
# Kila kitu kingine ni outstanding - ikiwemo rekodi ya PENDING/MISSED/
# LATE, kwa sababu kazi iliyokosekana bado ni kazi isiyofanyika.
# ============================================================

type DailyTaskStatus {
    taskId: ID!
    cycleId: Int
    # Kulisha - Asubuhi / Kulisha - Jioni / Kuangalia Maji
    taskType: String!
    # Saa ya siku (HH:mm). Inarudishwa ili mteja aweze kukokotoa
    # "overdue" (outstanding NA saa imepita) mwenyewe - haikokotolewi
    # hapa kwa sababu inahitaji kanda ya saa, uamuzi wa Reminders.
    scheduledTime: String!
    frequency: String!
    # Role iliyopangiwa kazi. NI null kwa data yote iliyopo:
    # CycleService.createDefaultTasks haiweki assigned_role_id.
    assignedRoleName: String
    # Tarehe iliyoulizwa (au leo)
    date: String!
    # DONE / PENDING / MISSED / LATE kama rekodi ipo; OUTSTANDING kama
    # haipo kabisa. Ina maelezo zaidi kuliko `done`.
    status: String!
    # Bendera moja isiyo na utata - ndiyo Reminders inayoisoma
    done: Boolean!
    completedAt: String
    completedByName: String
    notes: String
}

input CompleteTaskInput {
    taskId: Int!
    # Ikiachwa wazi, inatumia leo
    completionDate: String
    notes: String
}

# Module iliyobaki (Finance) itaongezwa hapa kwa muundo uleule -
# angalia SRS §8 kwa orodha kamili.
