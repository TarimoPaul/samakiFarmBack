type Query {
    productionUnits: [ProductionUnit!]!
    cycles(status: String): [Cycle!]!

    # Katalogi ya kimfumo - inahitajika kujaza speciesId ya CreateCycleInput
    species: [Species!]!

    # ---------- Feed ----------
    feedPurchases: [FeedPurchase!]!
    feedingLogs(cycleId: Int): [FeedingLog!]!
    feedStockMovements: [FeedStockMovement!]!

    # Salio la stoo, MSTARI MMOJA KWA KILA AINA ya chakula, kwa shamba la
    # mwombaji. Ilikuwa `Float!` moja - angalia FeedStockBalance hapo chini
    # kwa sababu ya kubadilika. Orodha tupu = hakuna chakula chochote
    # kilichowahi kuingia wala kutoka.
    feedStockBalance: [FeedStockBalance!]!

    # Katalogi ya aina za chakula, kwa ukurasa wa kuisimamia.
    # activeOnly ikiachwa wazi (au true): zinazotumika pekee.
    feedTypes(activeOnly: Boolean): [FeedType!]!

    # Chakula gani kinafaa samaki wa mzunguko huu LEO. Hakirudishi kamwe
    # chakula cha samaki wakubwa kuliko hawa - angalia FeedService.classify.
    feedTypesForCycle(cycleId: Int!): FeedTypesForCycle!

    # ---------- Water Quality ----------
    # Bila hoja: vipimo vya shamba zima. unitId: tanki moja. cycleId:
    # vipimo vya tanki analomoendeshea mzunguko huo (jedwali halina
    # cycle_id - angalia WaterQualityService).
    waterQualityLogs(unitId: Int, cycleId: Int): [WaterQualityLog!]!

    # ---------- Daily Tasks ----------
    # Kazi ZOTE za mzunguko kwa siku moja, kila moja ikiwa na `done` yake.
    # `date` ikiachwa wazi ni leo. Huu ndio mkataba unaosomwa na Reminders -
    # angalia DailyTaskStatus hapo chini.
    dailyTasks(cycleId: Int!, date: String): [DailyTaskStatus!]!
}

type Mutation {
    createProductionUnit(input: CreateProductionUnitInput!): ProductionUnit!
    createCycle(input: CreateCycleInput!): Cycle!

    # ---------- Feed ----------
    recordFeedPurchase(input: RecordFeedPurchaseInput!): FeedPurchase!
    logFeeding(input: LogFeedingInput!): FeedingLog!

    # Aina mpya kwenye katalogi ya kimfumo. maxAgeMonths lazima isiwe chini
    # ya minAgeMonths (VALIDATION_ERROR vinginevyo).
    createFeedType(name: String!, minAgeMonths: Int!, maxAgeMonths: Int!): FeedType!

    # Kuhariri aina iliyopo. Sheria za dirisha ni ZILE ZILE za kusajili.
    # HAIGUSI `active` - hiyo ina mutation yake.
    updateFeedType(feedTypeId: Int!, name: String!, minAgeMonths: Int!, maxAgeMonths: Int!): FeedType!

    # Kuzima / kurudisha. Aina iliyozimwa inabaki kwenye katalogi na kwenye
    # rekodi za zamani; haitokei tena kwenye feedTypesForCycle, hivyo
    # haiwezi kuchaguliwa kwa ulishaji mpya. Ndiyo njia iliyokusudiwa na
    # V16 kwa aina inayoachwa kutumika.
    setFeedTypeActive(feedTypeId: Int!, active: Boolean!): FeedType!

    # Soft-delete. INAKATALIWA kwa FEED_TYPE_IN_USE ikiwa ulishaji, manunuzi
    # au leja yoyote inaielekea - angalia FeedService.deleteFeedType.
    # Inarudisha `true`; kushindwa kunakuja kama hitilafu.
    deleteFeedType(feedTypeId: Int!): Boolean!

    # ---------- Water Quality ----------
    logWaterQuality(input: LogWaterQualityInput!): WaterQualityLog!

    # ---------- Daily Tasks ----------
    completeTask(input: CompleteTaskInput!): DailyTaskStatus!
}

type ProductionUnit {
    unitId: ID!
    code: String!
    type: String!
    sizeM3: Float
    waterSource: String
    status: String!
}

input CreateProductionUnitInput {
    code: String!
    type: String!
    sizeM3: Float
    waterSource: String
}

# Aina ya samaki. Ni katalogi ya kimfumo (haina farm_id) - inasomwa tu;
# hakuna mutation ya kuunda/kuhariri kwa makusudi.
type Species {
    speciesId: ID!
    name: String!
    # Miezi ya wastani hadi mavuno - ndiyo inayokokotoa expectedHarvestDate
    growthMonthsAvg: Float!
    avgHarvestWeightKg: Float!
}

type Cycle {
    cycleId: ID!
    unit: ProductionUnit!
    speciesName: String!
    stockingDate: String!
    fingerlingsCount: Int!
    survivalRateEstimate: Float!
    expectedHarvestDate: String
    actualHarvestDate: String
    status: String!
}

input CreateCycleInput {
    unitId: ID!
    speciesId: ID!
    stockingDate: String!
    fingerlingsCount: Int!
    survivalRateEstimate: Float
}

# ============================================================
# Feed — katalogi ya chakula, ununuzi, ulishaji, na leja ya stoo
#
# `feedType` ilikuwa MAANDISHI HURU kwenye ununuzi na ulishaji. Sasa ni
# katalogi (angalia V16__feed_type_catalog.sql). Maandishi huru hayakuweza
# kujibu swali linaloamua kila mlo: chakula hiki ni cha samaki wa umri
# gani? - wala kuruhusu salio la stoo kuhesabiwa kwa aina.
# ============================================================

# Aina ya chakula. Ni katalogi YA KIMFUMO (haina farm_id), kama Species -
# mashamba yote yanaisoma ile ile.
type FeedType {
    feedTypeId: ID!
    name: String!
    # Dirisha la umri ambalo chakula hiki kimetengenezwa kwa ajili yake, kwa
    # miezi, PANDE ZOTE MBILI ZIKIHUSISHWA. Chakula cha vifaranga ni [0, 0].
    minAgeMonths: Int!
    maxAgeMonths: Int!
    # Aina isiyotumika tena inazimwa, haifutwi - rekodi za zamani
    # zinaielekea.
    active: Boolean!
}

# Mstari mmoja wa salio. Kilo za aina moja haziwezi kulisha samaki
# wanaohitaji nyingine, hivyo salio moja la shamba zima lilikuwa
# linadanganya: +50 ya chakula cha vifaranga na -50 cha wakubwa
# zilighairiana hadi 0, ghala lenye chakula likionekana tupu.
type FeedStockBalance {
    feedType: FeedType!
    # Inaweza kuwa HASI: leja inaripoti, haihukumu (angalia FeedService).
    quantityKg: Float!
}

# Aina pamoja na SABABU ya kuwa kwenye orodha ya kufaa.
type SuitableFeedType {
    feedType: FeedType!
    # EXACT      - min <= umri <= max; kilichokusudiwa umri huu.
    # SAFE_LOWER - max < umri; chakula cha wadogo, wakubwa wanakila.
    # UNSAFE_HIGHER HAIONEKANI HAPA KAMWE: chakula cha samaki wakubwa
    # kuliko hawa hakirudishwi kabisa, kwa sababu chochote kilicho kwenye
    # orodha ya kuchagua kitachaguliwa na mtu fulani siku fulani.
    suitability: String!
}

type FeedTypesForCycle {
    # Miezi mizima tangu kuwekwa kwa vifaranga, ikishushwa chini, si chini
    # ya sifuri. Inarudishwa ili mteja aeleze uamuzi bila kuukokotoa upya.
    cycleAgeMonths: Int!
    # true = KILA aina inayotumika ni ya samaki wakubwa kuliko hawa (au
    # katalogi ni tupu). Ni bendera yake yenyewe, si `feedTypes.isEmpty()`
    # inayokisiwa na mteja: orodha tupu hapa ni pengo halisi la katalogi
    # linalopaswa kuelezwa, si hali ya kawaida.
    noSuitableFeed: Boolean!
    # EXACT kwanza, kisha SAFE_LOWER; ndani ya kila daraja, kwa jina.
    feedTypes: [SuitableFeedType!]!
}

type FeedPurchase {
    purchaseId: ID!
    purchaseDate: String!
    feedType: FeedType!
    quantityKg: Float!
    unitCost: Float!
    # Inakokotolewa na database (GENERATED ALWAYS) - si sehemu ya input
    totalCost: Float
    supplier: String
}

input RecordFeedPurchaseInput {
    purchaseDate: String!
    feedTypeId: Int!
    quantityKg: Float!
    unitCost: Float!
    supplier: String
}

type FeedingLog {
    logId: ID!
    cycle: Cycle!
    logDate: String!
    # SI NULL tena (ilikuwa `String`). Ulishaji usiotaja chakula hauwezi
    # kupunguza salio la aina yoyote, hivyo ungeacha stoo ikidai kilo
    # ambazo samaki tayari wamekula.
    feedType: FeedType!
    quantityKg: Float!
    recordedByName: String
}

input LogFeedingInput {
    cycleId: Int!
    # Ikiachwa wazi, inatumia leo
    logDate: String
    # INAKAGULIWA dhidi ya umri wa mzunguko kwa sheria ile ile ya
    # feedTypesForCycle (FeedService.classify). Vinavyokataliwa kwa
    # VALIDATION_ERROR ni VIWILI TU: chakula cha samaki WAKUBWA kuliko hawa
    # (minAgeMonths > umri), na aina iliyozimwa.
    #
    # SAFE_LOWER INARUHUSIWA kwa makusudi: kulisha wakubwa chakula cha
    # wadogo ni uamuzi halali (stoo imeisha, mfuko wa mwisho), si kosa.
    # Onyo ni kazi ya UI, si la server kuzuia.
    feedTypeId: Int!
    quantityKg: Float!
}

# Leja inayozalishwa na mfumo: kununua -> IN, kulisha -> OUT.
# Haiandikwi moja kwa moja na mteja (angalia FeedService).
type FeedStockMovement {
    movementId: ID!
    feedType: FeedType!
    direction: String!
    quantityKg: Float!
    referencePurchaseId: Int
    referenceFeedingLogId: Int
    movedAt: String!
}

# ============================================================
# Water Quality — vipimo vya maji kwenye kitengo
#
# Kipimo ni cha KITENGO, si cha mzunguko (water_quality_logs.unit_id):
# maji ni mali ya tanki, si ya samaki walioko ndani yake msimu huu.
#
# Vipimo vyote vinne vinaweza kuwa null - mtu mwenye kipima-pH pekee
# anarekodi pH, na kuacha nyingine wazi ni sahihi zaidi kuliko sifuri.
#
# THAMANI MBAYA INAKUBALIWA. Oksijeni 0.8, pH 4.2, amonia 0.9 - hizi
# ndizo sababu ya kupima, na amonia ndiyo chanzo kikuu cha vifo vya
# ghafla. Kinachokataliwa ni kisichowezekana kimuundo pekee: pH nje ya
# 0-14, oksijeni au amonia hasi (angalia WaterQualityService).
# ============================================================

type WaterQualityLog {
    logId: ID!
    unit: ProductionUnit!
    logDate: String!
    # 0.0 - 14.0
    ph: Float
    # Nyuzi Selsiasi
    temperature: Float
    # Oksijeni iliyoyeyuka (DO), mg/L
    oxygen: Float
    # Amonia jumla (NH3 + NH4+), mg/L. Desimali mbili: 0.02 ni salama,
    # 0.25 inaua polepole.
    ammonia: Float
    notes: String
    recordedByName: String
}

input LogWaterQualityInput {
    unitId: Int!
    # Ikiachwa wazi, inatumia leo
    logDate: String
    ph: Float
    temperature: Float
    oxygen: Float
    ammonia: Float
    notes: String
}

# ============================================================
# Daily Tasks — kazi za kila siku na ukamilishaji wake
#
# `daily_tasks` ni KIOLEZO kinachojirudia (frequency=DAILY,
# scheduled_time ni saa ya siku, hakuna tarehe ya mwisho). Hivyo
# "imekamilika" si bendera juu ya kiolezo - ingekuwa kweli milele baada
# ya siku ya kwanza - bali ni REKODI ya `task_completions`, moja kwa
# (kiolezo, tarehe), kama UNIQUE(task_id, completion_date) ya V1
# inavyolazimisha.
#
# MKATABA WA REMINDERS, na ndiyo sababu type hii ipo:
#
#     done = kuna rekodi ya (task_id, tarehe) yenye status DONE
#
# Kila kitu kingine ni outstanding - ikiwemo rekodi ya PENDING/MISSED/
# LATE, kwa sababu kazi iliyokosekana bado ni kazi isiyofanyika.
# ============================================================

type DailyTaskStatus {
    taskId: ID!
    cycleId: Int
    # Kulisha - Asubuhi / Kulisha - Jioni / Kuangalia Maji
    taskType: String!
    # Saa ya siku (HH:mm). Inarudishwa ili mteja aweze kukokotoa
    # "overdue" (outstanding NA saa imepita) mwenyewe - haikokotolewi
    # hapa kwa sababu inahitaji kanda ya saa, uamuzi wa Reminders.
    scheduledTime: String!
    frequency: String!
    # Role iliyopangiwa kazi. NI null kwa data yote iliyopo:
    # CycleService.createDefaultTasks haiweki assigned_role_id.
    assignedRoleName: String
    # Tarehe iliyoulizwa (au leo)
    date: String!
    # DONE / PENDING / MISSED / LATE kama rekodi ipo; OUTSTANDING kama
    # haipo kabisa. Ina maelezo zaidi kuliko `done`.
    status: String!
    # Bendera moja isiyo na utata - ndiyo Reminders inayoisoma
    done: Boolean!
    completedAt: String
    completedByName: String
    notes: String
}

input CompleteTaskInput {
    taskId: Int!
    # Ikiachwa wazi, inatumia leo
    completionDate: String
    notes: String
}

# Module iliyobaki (Finance) itaongezwa hapa kwa muundo uleule -
# angalia SRS §8 kwa orodha kamili.
