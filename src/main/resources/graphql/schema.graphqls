type Query {
    productionUnits: [ProductionUnit!]!
    cycles(status: String): [Cycle!]!

    # Hali ya shamba TAREHE MOJA mahususi - dashibodi ya "siku ile".
    #
    # HAKUNA jedwali la historia nyuma yake, wala migration. Kila namba
    # inakokotolewa kutoka kwa data iliyopo: `created_at`/`deleted_at` za
    # vitengo na uanachama, na `stocking_date`/`actual_harvest_date` za
    # mizunguko. Status ya kitengo inaendeshwa na mizunguko PEKEE (angalia
    # CycleService), hivyo "kilikuwa ACTIVE" ni sawa kabisa na "kilikuwa na
    # mzunguko unaoendelea".
    #
    # Kwa sababu inakokotolewa badala ya kukusanywa, inafanya kazi kwa tarehe
    # ZA NYUMA pia - mfumo wa kukusanya historia ungeanza leo na tarehe za
    # nyuma zingebaki tupu milele.
    #
    # `view_dashboard` + muktadha wa shamba: ruhusa ile ile ya dashibodi ya leo.
    dashboardOnDate(date: String!): DashboardDay!

    # Katalogi ya kimfumo - inahitajika kujaza speciesId ya CreateCycleInput
    species: [Species!]!

    # ---------- Feed ----------
    # Manunuzi ya SHAMBA LA MWOMBAJI pekee (`view_dashboard` + muktadha wa
    # shamba). BEI INAFICHWA hapa, si kwenye UI: bila `view_feed_cost`,
    # kila mstari unarudi na unitCost/totalCost = null huku kiasi, aina,
    # tarehe na muuzaji vikibaki - angalia FeedService.listPurchases.
    feedPurchases: [FeedPurchase!]!
    feedingLogs(cycleId: Int): [FeedingLog!]!
    feedStockMovements: [FeedStockMovement!]!

    # Salio la stoo, MSTARI MMOJA KWA KILA AINA ya chakula, kwa shamba la
    # mwombaji. Ilikuwa `Float!` moja - angalia FeedStockBalance hapo chini
    # kwa sababu ya kubadilika. Orodha tupu = hakuna chakula chochote
    # kilichowahi kuingia wala kutoka.
    feedStockBalance: [FeedStockBalance!]!

    # Katalogi ya aina za chakula, kwa ukurasa wa kuisimamia.
    # activeOnly ikiachwa wazi (au true): zinazotumika pekee.
    feedTypes(activeOnly: Boolean): [FeedType!]!

    # Chakula gani kinafaa samaki wa mzunguko huu LEO. Hakirudishi kamwe
    # chakula cha samaki wakubwa kuliko hawa - angalia FeedService.classify.
    feedTypesForCycle(cycleId: Int!): FeedTypesForCycle!

    # ---------- Assets ----------
    # DAFTARI LA MALI LA KAMPUNI NZIMA - si la shamba moja.
    #
    # Hii ndiyo query PEKEE kwenye schema hii inayovuka mashamba:
    # inarudisha mali za MASHAMBA YOTE ambayo mwombaji ni mwanachama au
    # mmiliki wake, si za shamba lake "teule". Ndiyo maana kila mstari
    # unabeba `farm` yake - bila hiyo, orodha isingeweza kupangwa wala
    # kujumlishwa kwa shamba.
    #
    # JUMLA (kwa shamba, na ya kampuni) NI KAZI YA FRONTEND kwa makusudi:
    # hakuna endpoint ya kujumlisha, na haipaswi kuwepo bado - angalia
    # AssetResolver.
    #
    # `manage_assets` (V22 - OWNER/FARM_MANAGER). Mwombaji asiye na
    # shamba lolote anapata orodha TUPU, si hitilafu.
    assets: [Asset!]!

    # Katalogi ya aina za mali, kwa fomu ya kuandikisha. `manage_assets`.
    assetCategories: [AssetCategory!]!

    # MASHAMBA YA MWOMBAJI - yale anayoyamiliki au kuwa mwanachama wake.
    #
    # Ni kichagua-shamba cha fomu ya kuandikisha mali. Bila hii,
    # kichagua-shamba kingeweza kutoa shamba BAADA tu ya shamba hilo
    # kuwa na mali (`assets` ndiyo mahali pekee farmId ilipoonekana) -
    # yaani mali ya kwanza ya kila shamba isingeweza kuandikishwa kamwe.
    #
    # SI /api/farms. Ile ni ya `manage_farms` na inarudisha mashamba YOTE
    # ya kampuni; hii inarudisha YAKE pekee, ikitumia uanachama ule ule
    # ambao `assets` na `createAsset` wanautumia (AssetService.callersFarmIds).
    #
    # HAINA RUHUSA YA KUILINDA - kuingia (login) pekee, si `manage_assets`.
    # Mashamba ya mtu mwenyewe si data ya kampuni: ni jibu la "wewe ni
    # nani hapa", ambalo tayari analijua. Mwombaji asiye na shamba lolote
    # anapata orodha TUPU, si hitilafu - kama `assets`.
    #
    # Inarudisha AssetFarm (farmId + name) kwa makusudi, si aina mpya:
    # kila chaguo hapa ndicho hasa kinachokuwa `Asset.farm` ya mali
    # itakayoandikishwa, na uga zilezile mbili ndizo zinazohitajika.
    myFarms: [AssetFarm!]!

    # ---------- Gharama za uendeshaji ----------
    # DAFTARI LA GHARAMA LA KAMPUNI NZIMA - si la shamba moja, kama
    # `assets`. Kila mstari unabeba shamba lake NA mzunguko wake (ikiwa
    # unao), kwa sababu orodha inavuka mashamba.
    #
    # JUMLA NI KAZI YA FRONTEND kwa makusudi - hakuna endpoint ya
    # kujumlisha kwa mzunguko wala kwa shamba (angalia CostResolver).
    #
    # `manage_costs` (V24 - OWNER/FARM_MANAGER). Mwombaji asiye na shamba
    # lolote anapata orodha TUPU, si hitilafu.
    costs: [Cost!]!

    # Katalogi ya aina za gharama, kwa fomu ya kurekodi. `manage_costs`.
    costCategories: [CostCategory!]!

    # KICHAGUA-MZUNGUKO cha fomu ya gharama: mizunguko ya shamba MOJA,
    # INAYOENDELEA NA ILIYOFUNGWA.
    #
    # SI `cycles` hapo juu, na tofauti ni mbili. (1) `cycles` ni ya
    # shamba TEULE la mwombaji (requireFarmScope), ilhali fomu ya gharama
    # inaruhusu kuchagua lolote kati ya mashamba yake - mmiliki wa
    # mashamba mawili asingepata mizunguko ya la pili kabisa. (2) Hapa
    # kila chaguo linakuja na LEBO iliyokwisha jengwa (angalia CycleRef).
    #
    # ILIYOFUNGWA IMO kwa makusudi: bili ya Machi inalipwa Aprili, mara
    # nyingi baada ya mzunguko kuvunwa. Kichagua kisichoonyesha
    # iliyofungwa kingelazimisha gharama hiyo kuwa ya shamba zima.
    #
    # `manage_costs`, na farmId lazima iwe ya mwombaji (FORBIDDEN
    # vinginevyo).
    farmCycles(farmId: Int!): [CycleRef!]!

    # Kinachopotea aina hii ikizimwa, KWA SHAMBA LA MWOMBAJI. Ni ONYO la
    # kabla ya kubofya - setFeedTypeActive HAIKATAI kuzima kwa sababu ya
    # namba hizi (angalia FeedTypeDeactivationImpact hapo chini).
    # `manage_feed_stock`, ile ile ya kitendo chenyewe. HAIANDIKI chochote.
    feedTypeDeactivationImpact(feedTypeId: Int!): FeedTypeDeactivationImpact!

    # ---------- Water Quality ----------
    # Bila hoja: vipimo vya shamba zima. unitId: tanki moja. cycleId:
    # vipimo vya tanki analomoendeshea mzunguko huo (jedwali halina
    # cycle_id - angalia WaterQualityService).
    waterQualityLogs(unitId: Int, cycleId: Int): [WaterQualityLog!]!

    # ---------- Matukio ya mavuno ----------
    # Matukio ya mzunguko mmoja, mapya kwanza - wa kuendelea NA uliofungwa.
    # `view_dashboard`, kama `cycles`; mzunguko lazima uwe wa shamba la
    # mwombaji (FORBIDDEN). saleAmount inarudi null bila `view_finance`.
    harvestEvents(cycleId: Int!): [HarvestEvent!]!

    # ---------- Daily Tasks ----------
    # Kazi ZOTE za mzunguko kwa siku moja, kila moja ikiwa na `done` yake.
    # `date` ikiachwa wazi ni leo. Huu ndio mkataba unaosomwa na Reminders -
    # angalia DailyTaskStatus hapo chini.
    dailyTasks(cycleId: Int!, date: String): [DailyTaskStatus!]!

    # Kazi za SHAMBA ZIMA kwa siku moja - mizunguko YOTE inayoendelea
    # (ACTIVE), si mmoja. Ndio mwonekano wa mfanyakazi anayefungua simu
    # asubuhi, na wa mmiliki anayeuliza "tarehe hii, ni zipi
    # zilifanyika na nani?" - swali moja, upeo mmoja, safari MOJA ya
    # mtandao badala ya `cycles` + `dailyTasks` kwa kila mzunguko.
    #
    # HAKUNA hoja ya shamba: linatoka kwenye token. `date` ikiachwa wazi
    # ni leo - LEO YA EAT (Africa/Nairobi), si ya server.
    #
    # `view_dashboard`, ILE ILE ya dailyTasks. Hakuna ruhusa mpya.
    farmDailyTasks(date: String): [DailyTaskStatus!]!
}

type Mutation {
    createProductionUnit(input: CreateProductionUnitInput!): ProductionUnit!
    createCycle(input: CreateCycleInput!): Cycle!

    # Kufunga mzunguko - KWA MKONO, DAIMA. Hakuna scheduler wala tarehe
    # inayofanya hivi; `expectedHarvestDate` ni utabiri, si kichocheo.
    #
    # `outcome`: HARVESTED au FAILED (si ACTIVE - hii ni ya kufunga).
    #
    # MKATABA ULIBADILIKA (V25): HAKUNA harvestedCount wala totalWeightKg
    # tena. Jumla zote zinajumlishwa kutoka matukio ya mavuno
    # (recordHarvestEvent) wakati wa kufunga:
    #   harvestedCount = SOLD + REMOVED   (waliotoka WAKIWA HAI)
    #   mortalityCount = DIED
    #   totalWeightKg  = uzito wa SOLD + REMOVED
    #   totalRevenue   = saleAmount ya SOLD
    # HARVESTED inahitaji angalau samaki mmoja wa SOLD/REMOVED
    # (VALIDATION_ERROR vinginevyo - tumia FAILED). FAILED inakubali
    # mzunguko usio na tukio lolote.
    #
    # actualHarvestDate: SI kabla ya kuweka, wala kabla ya tukio la mwisho.
    #
    # KUFUNGA NI KWA MWISHO: mzunguko uliokwisha fungwa unakataliwa kwa
    # CYCLE_ALREADY_CLOSED, na baada ya hapo matukio hayarekodiwi wala
    # kufutwa. Hakuna kufungua upya.
    #
    # `edit_cycle`, ILE ILE ya createCycle. Hakuna ruhusa mpya.
    #
    # HAKUNA uga wa kiwango cha kuishi hapa KWA MAKUSUDI - angalia
    # Cycle.actualSurvivalRate.
    closeCycle(
        cycleId: Int!
        outcome: String!
        actualHarvestDate: String!
        notes: String
    ): Cycle!

    # ---------- Matukio ya mavuno ----------
    # Samaki waliotoka kwenye bwawa: SOLD (wameuzwa), DIED (wamekufa),
    # REMOVED (wametolewa wakiwa hai bila kuuzwa). Hakuna sababu nyingine
    # (VALIDATION_ERROR ikiorodhesha tatu hizi).
    #
    # `record_harvest` (V26 - OWNER/FARM_MANAGER pekee). Mzunguko lazima
    # uwe wa shamba la mwombaji (FORBIDDEN) na UNAOENDELEA
    # (CYCLE_ALREADY_CLOSED).
    #
    # eventDate: YYYY-MM-DD, si kabla ya kuweka, si ya baadaye.
    # fishCount: > 0. HAIKATALIWI ikizidi fingerlingsCount - kuhesabu
    #   samaki si sayansi kamili (kuishi kunaweza kuzidi 1.0).
    # weightKg: LAZIMA (> 0) kwa SOLD; hiari kwa DIED/REMOVED (> 0
    #   ikitolewa).
    # saleAmount: LAZIMA (> 0) kwa SOLD. Kwa DIED/REMOVED: null au 0
    #   inakubalika na inahifadhiwa kama null; kiasi kingine chochote
    #   kinakataliwa.
    recordHarvestEvent(
        cycleId: Int!
        eventDate: String!
        fishCount: Int!
        weightKg: Float
        reason: String!
        saleAmount: Float
    ): HarvestEvent!

    # Soft-delete ya tukio lililokosewa - kwa mzunguko UNAOENDELEA pekee
    # (CYCLE_ALREADY_CLOSED vinginevyo). Kurekebisha = kufuta + kurekodi
    # upya. `record_harvest`. Inarudisha `true`; kushindwa ni hitilafu.
    deleteHarvestEvent(harvestEventId: Int!): Boolean!

    # ---------- Feed ----------
    recordFeedPurchase(input: RecordFeedPurchaseInput!): FeedPurchase!

    # Kubatilisha ununuzi kwa REKODI YA KUREKEBISHA - movement ya OUT ya kilo
    # zile zile - si kwa kuufuta. Safu inabaki kwenye orodha ikiwa
    # `reversed: true`; salio la stoo linarudi lilipokuwa.
    # PURCHASE_ALREADY_REVERSED ikiwa umeshabatilishwa.
    reverseFeedPurchase(purchaseId: Int!): FeedPurchase!

    # Kubatilisha wa zamani NA kurekodi mpya, kwenye transaction MOJA - hivyo
    # shamba haliwezi kubaki limepoteza kilo kwa sababu ombi la pili
    # limeshindwa. Inarudisha ununuzi MPYA.
    correctFeedPurchase(purchaseId: Int!, input: RecordFeedPurchaseInput!): FeedPurchase!
    logFeeding(input: LogFeedingInput!): FeedingLog!

    # Aina mpya kwenye katalogi ya kimfumo. maxAgeMonths lazima isiwe chini
    # ya minAgeMonths (VALIDATION_ERROR vinginevyo).
    createFeedType(name: String!, minAgeMonths: Int!, maxAgeMonths: Int!): FeedType!

    # ---------- Species ----------
    # Aina mpya ya samaki kwenye katalogi ya kimfumo (`manage_species`).
    #
    # jina: LAZIMA na la kipekee - CONFLICT ikiwa limechukuliwa, ikiwemo na
    # aina iliyofutwa (safu yake ipo, na `species.name` ni UNIQUE).
    # growthMonthsAvg na avgHarvestWeightKg: zaidi ya sifuri
    # (VALIDATION_ERROR vinginevyo).
    #
    # growthMonthsAvg INAHIFADHI nusu-mwezi: 6.5 ni thamani halali, na ndiyo
    # inayokokotoa expectedHarvestDate ya kila mzunguko wa aina hii.
    createSpecies(name: String!, growthMonthsAvg: Float!, avgHarvestWeightKg: Float!): Species!

    # Kuhariri aina iliyopo. Sheria za dirisha ni ZILE ZILE za kusajili.
    # HAIGUSI `active` - hiyo ina mutation yake.
    updateFeedType(feedTypeId: Int!, name: String!, minAgeMonths: Int!, maxAgeMonths: Int!): FeedType!

    # Kuzima / kurudisha. Aina iliyozimwa inabaki kwenye katalogi na kwenye
    # rekodi za zamani; haitokei tena kwenye feedTypesForCycle, hivyo
    # haiwezi kuchaguliwa kwa ulishaji mpya. Ndiyo njia iliyokusudiwa na
    # V16 kwa aina inayoachwa kutumika.
    setFeedTypeActive(feedTypeId: Int!, active: Boolean!): FeedType!

    # Soft-delete. INAKATALIWA kwa FEED_TYPE_IN_USE ikiwa ulishaji, manunuzi
    # au leja yoyote inaielekea - angalia FeedService.deleteFeedType.
    # Inarudisha `true`; kushindwa kunakuja kama hitilafu.
    deleteFeedType(feedTypeId: Int!): Boolean!

    # ---------- Assets ----------
    # Kuandikisha mali. `manage_assets` (V22 - OWNER/FARM_MANAGER pekee).
    #
    # farmId: LAZIMA, na LAZIMA liwe mojawapo ya mashamba ya mwombaji
    # (uanachama au umiliki) - FORBIDDEN vinginevyo. Si lazima liwe
    # shamba lake "teule": mmiliki wa mashamba mawili anaandikisha
    # kwenye lolote kati yao (angalia AssetService.requireCallersFarm).
    #
    # cost: zaidi ya sifuri (VALIDATION_ERROR vinginevyo). NUMERIC(14,2).
    # acquiredDate: YYYY-MM-DD, HAIWEZI kuwa ya baadaye. Ya nyuma ni
    #   halali kabisa - daftari linaanzishwa leo kwa vitu vya zamani.
    # sizeLabel: hiari, maandishi huru ("5000L", "ekari 2", "20HP").
    createAsset(
        name: String!
        farmId: Int!
        cost: Float!
        acquiredDate: String!
        sizeLabel: String
        assetCategoryId: Int!
    ): Asset!

    # Aina mpya kwenye katalogi ya kimfumo ya mali. Jina la kipekee -
    # CONFLICT ikiwa limechukuliwa, IKIWEMO na aina iliyofutwa (safu
    # yake ipo, na `asset_categories.name` ni UNIQUE).
    createAssetCategory(name: String!): AssetCategory!

    # ---------- Gharama za uendeshaji ----------
    # Kurekodi gharama. `manage_costs` (V24 - OWNER/FARM_MANAGER pekee).
    #
    # farmId: LAZIMA, na LAZIMA liwe mojawapo ya mashamba ya mwombaji -
    #   FORBIDDEN vinginevyo. Sheria ile ile ya createAsset.
    #
    # cycleId: HIARI, na hapa ndipo module hii inapotofautiana na mali.
    #   Ikiachwa wazi (null) -> gharama ya SHAMBA ZIMA: umeme, mshahara,
    #   kodi - vitu visivyogawanyika kwa mzunguko. Ikitolewa -> gharama
    #   ya mzunguko HUO, na mzunguko LAZIMA uwe wa `farmId` iliyotajwa
    #   (VALIDATION_ERROR vinginevyo - jibu lile lile kwa mzunguko usiopo
    #   na wa shamba jingine, ili idadi ya mizunguko ya mashamba mengine
    #   isivuje). Mzunguko ULIOFUNGWA unakubalika: bili inalipwa baada ya
    #   mavuno mara nyingi.
    #
    # amount: zaidi ya sifuri (VALIDATION_ERROR vinginevyo). NUMERIC(14,2).
    # costDate: YYYY-MM-DD, HAIWEZI kuwa ya baadaye - gharama
    #   isiyotokea bado ni bajeti, si matumizi. Ya nyuma ni ya kawaida
    #   kabisa (bili ya Machi inaingizwa Aprili).
    # description: hiari, maandishi huru ("LUKU ya Machi").
    createCost(
        farmId: Int!
        cycleId: Int
        costCategoryId: Int!
        amount: Float!
        costDate: String!
        description: String
    ): Cost!

    # Aina mpya kwenye katalogi ya kimfumo ya gharama. Jina la kipekee -
    # CONFLICT ikiwa limechukuliwa, IKIWEMO na aina iliyofutwa (safu
    # yake ipo, na `cost_categories.name` ni UNIQUE).
    createCostCategory(name: String!): CostCategory!

    # ---------- Water Quality ----------
    logWaterQuality(input: LogWaterQualityInput!): WaterQualityLog!

    # ---------- Daily Tasks ----------
    completeTask(input: CompleteTaskInput!): DailyTaskStatus!
}

type ProductionUnit {
    unitId: ID!
    code: String!
    type: String!
    sizeM3: Float
    waterSource: String
    status: String!
}

# Vitengo vya aina moja vilivyokuwepo tarehe iliyoulizwa.
type UnitTypeCount {
    type: String!
    count: Int!
}

# Jibu la `dashboardOnDate` - hali ya shamba siku moja.
type DashboardDay {
    # Tarehe iliyoulizwa, ikirudishwa ili UI isilinganishe na iliyoomba.
    date: String!

    # Vitengo vilivyokuwepo siku hiyo (viliundwa kabla yake na havikuwa
    # vimefutwa bado). Kitengo kilichofutwa jana KILIKUWEPO wiki iliyopita.
    unitsExisting: Int!

    # Vilivyokuwa na mzunguko unaoendelea siku hiyo.
    unitsActive: Int!

    # Vilivyobaki. MAINTENANCE haipo hapa kwa sababu hakuna msimbo wowote
    # unaoiandika - ikija, itabidi igawanywe.
    unitsIdle: Int!

    # Ujazo wa vitengo vilivyokuwepo siku hiyo.
    totalVolumeM3: Float!

    cyclesRunning: Int!
    cyclesStarted: Int!
    cyclesClosed: Int!

    # Vifaranga walio ndani ya mizunguko ILIYOKUWA INAENDELEA - hifadhi.
    # Hii ndiyo inayolingana na tile ya dashibodi ya leo.
    fingerlingsRunning: Int!

    # Vifaranga walioingizwa SIKU HIYO - mtiririko. Kitu kingine kabisa, na
    # kuzichanganya kungebadilisha maana ya namba bila mtu kujua.
    fingerlingsStocked: Int!

    # Wanachama wa shamba siku hiyo (farm_users ni soft-delete, hivyo
    # aliyeondolewa bado anahesabiwa kwa tarehe alizokuwepo).
    members: Int!

    # Vitengo kwa AINA, siku hiyo. Aina isiyo na kitengo siku hiyo HAIPO
    # kwenye orodha - mteja anajaza sifuri kutoka kwa orodha yake ya aina,
    # ili kadi isibadilike umbo kulingana na data iliyopo.
    unitsByType: [UnitTypeCount!]!

    # Tarehe ya kwanza tuliyo na rekodi yake kwa shamba hili.
    historyStartsOn: String

    # false = tarehe iliyoulizwa iko KABLA ya rekodi yetu ya kwanza. Namba
    # zote hapo juu ni sifuri, na sifuri hiyo ina maana ya "hatujui", si
    # "hapakuwa na kitu". UI lazima itofautishe hizo mbili.
    historyComplete: Boolean!
}

input CreateProductionUnitInput {
    code: String!
    type: String!
    sizeM3: Float
    waterSource: String
}

# Aina ya samaki. Ni katalogi ya kimfumo (haina farm_id): aina moja
# inaonekana kwa MASHAMBA YOTE.
#
# Kusoma ni `view_dashboard` (kila anayechagua aina wakati wa kuunda
# mzunguko anaihitaji); kuandika ni `manage_species` (V20 - OWNER na
# FARM_MANAGER pekee). Hakuna kuhariri wala kufuta kwa makusudi -
# angalia SpeciesService.create.
# ============================================================
# MALI (assets) - V21/V22
#
# Daftari la vitu kampuni inavyomiliki. Tofauti na kila kitu kingine
# hapa, kusoma ni kwa KAMPUNI NZIMA: mmiliki wa mashamba matatu anaona
# orodha moja inayovuka yote (angalia Query.assets na AssetService).
# ============================================================

# Kitu kimoja kinachomilikiwa - generator, pikipiki, jengo, tanki.
type Asset {
    assetId: ID!
    name: String!

    # SHAMBA LA MALI HII. Ipo kwenye kila mstari kwa sababu orodha
    # inavuka mashamba - ndiyo lebo inayoruhusu frontend kupanga na
    # kujumlisha kwa shamba.
    farm: AssetFarm!

    assetCategory: AssetCategory!

    # Bei ya kununulia (NUMERIC(14,2)). Daima > 0.
    cost: Float!

    # Lebo ya ukubwa ya HIARI: "5000L", "ekari 2", "20HP". Ni maandishi
    # ya kusoma, si namba ya kukokotoa - vitu vya daftari hili
    # havishiriki kipimo kimoja.
    sizeLabel: String

    # YYYY-MM-DD. Kamwe si ya baadaye.
    acquiredDate: String!
}

# Shamba kama LEBO ya mali, si kama rasilimali kamili. Ina uga mbili
# tu ambazo daftari linazihitaji; mashamba yenyewe yanasimamiwa kupitia
# REST (/api/farms), si hapa.
type AssetFarm {
    farmId: ID!
    name: String!
}

# Aina ya mali. Katalogi YA KIMFUMO (haina farm_id), kama Species na
# FeedType - mashamba yote yanaisoma ile ile.
#
# NI YA KUUNDWA NA MTUMIAJI, si enum, na hiyo ndiyo hoja: orodha ya
# vitu shamba linavyoweza kumiliki haina mwisho, na "Nyingine" ya enum
# ni kundi ambalo jumla yake haielezi chochote.
type AssetCategory {
    assetCategoryId: ID!
    name: String!
}

# ============================================================
# GHARAMA ZA UENDESHAJI (costs) - V23/V24
#
# Mali ni MTAJI (kitu kilichonunuliwa kikabaki); gharama ni UENDESHAJI
# (fedha iliyotoka ikaisha). Madaftari yote mawili ni ya kampuni nzima
# na yanasomwa vivyo hivyo, lakini hii ina safu ambayo ile haina:
# MZUNGUKO, wa hiari.
# ============================================================

# Gharama moja - bili ya umeme, mafuta, mshahara, dawa.
type Cost {
    costId: ID!

    # SHAMBA LA GHARAMA HII. Ipo kwenye kila mstari kwa sababu orodha
    # inavuka mashamba - ndiyo lebo inayoruhusu frontend kupanga na
    # kujumlisha kwa shamba. Ni aina ile ile ya `Asset.farm`.
    farm: AssetFarm!

    # MZUNGUKO, IKIWA GHARAMA HII NI YAKE. Null = gharama ya SHAMBA
    # ZIMA (umeme wa mwezi, mshahara wa mlinzi) - si data
    # iliyokosekana, ni aina nyingine ya gharama. Ndiyo maana si `!`.
    #
    # Frontend inaweza kujumlisha kwa njia MBILI kutoka orodha moja:
    # gharama za mzunguko (mistari yenye `cycle`) na gharama zote za
    # shamba (mistari YOTE ya shamba hilo).
    cycle: CycleRef

    costCategory: CostCategory!

    # Kiasi (NUMERIC(14,2)). Daima > 0.
    amount: Float!

    # YYYY-MM-DD. Kamwe si ya baadaye.
    costDate: String!

    description: String
}

# Aina ya gharama. Katalogi YA KIMFUMO (haina farm_id), kama
# AssetCategory, FeedType na Species - mashamba yote yanaisoma ile ile.
#
# NI YA KUUNDWA NA MTUMIAJI, si enum, kwa hoja ile ile ya AssetCategory:
# orodha ya vitu shamba linavyoweza kutumia fedha haina mwisho, na
# "Nyingine" ya enum ndilo hasa kundi ambalo mkulima anataka
# kulichambua.
type CostCategory {
    costCategoryId: ID!
    name: String!
}

# Mzunguko kama LEBO ya kuchagua, si rasilimali kamili (linganisha na
# `Cycle`, yenye uga kumi na mbili). Inatumiwa na pande mbili za kitu
# kimoja: `farmCycles` (orodha ya kudondosha) na `Cost.cycle` (mstari
# uliohifadhiwa) - maandishi yale yale mahali pote.
type CycleRef {
    cycleId: ID!

    # "T1 - Sato (ACTIVE)". Inajengwa backend kwa sababu vipande vyake
    # vitatu vinatoka majedwali matatu tofauti (production_units,
    # species, cycles) - kila skrini ingeviunganisha yenyewe, au tofauti.
    label: String!

    # ACTIVE / HARVESTED / FAILED. Imo kwenye lebo tayari; inarudishwa
    # peke yake pia ili frontend iweze kupanga au kufifisha bila
    # kuchambua maandishi.
    status: String!
}

type Species {
    speciesId: ID!
    name: String!
    # Miezi ya wastani hadi mavuno - ndiyo inayokokotoa expectedHarvestDate
    growthMonthsAvg: Float!
    avgHarvestWeightKg: Float!
}

type Cycle {
    cycleId: ID!
    unit: ProductionUnit!
    speciesName: String!
    stockingDate: String!
    fingerlingsCount: Int!

    # Umri wa samaki (miezi) SIKU WALIPOWEKWA. 0 = wadogo kabisa, ndiyo
    # chaguo-msingi na ndiyo hali ya kila mzunguko wa zamani.
    stockingAgeMonths: Int!

    # MAKISIO ya siku ya kuweka (0.85 kama hayakutolewa). Hayabadiliki
    # kamwe baada ya hapo - hasa si wakati wa kuvuna. Linganisha na
    # actualSurvivalRate hapo chini; ndiyo maana yote mawili yapo.
    survivalRateEstimate: Float!

    # UTABIRI: stockingDate + (growthMonthsAvg ya aina - stockingAgeMonths).
    # Tarehe hii ikifika HAKUNA kinachobadilika - hakuna scheduler
    # inayoipitia na hakuna hali inayogeuka. Ni ya kuonyesha na kukumbusha
    # "wanakaribia kuvunwa"; KUFUNGA NI KAZI YA MTU (closeCycle).
    expectedHarvestDate: String

    # Gharama ya vifaranga (hiari - null = haikurekodiwa). FEDHA: null
    # bila `view_finance`, kwa kila njia inayofikia Cycle.
    fingerlingCost: Float

    # ---- Zinajazwa na closeCycle pekee; null kwa mzunguko unaoendelea ----
    # Zote zinajumlishwa kutoka matukio ya mavuno (V25), si kutoka kwa
    # mwombaji. Mizunguko iliyofungwa kabla ya V25 inabaki na namba zao
    # za mkono, na mortalityCount/totalRevenue null (hakuna backfill).
    actualHarvestDate: String
    # Samaki waliotoka WAKIWA HAI: SOLD + REMOVED.
    harvestedCount: Int
    # Uzito wa SOLD + REMOVED (kg).
    totalWeightKg: Float
    # Vifo: DIED. Havimo kwenye harvestedCount wala kuishi.
    mortalityCount: Int
    # Jumla ya saleAmount ya SOLD. FEDHA: null bila `view_finance`.
    totalRevenue: Float
    harvestNotes: String

    # KILICHOTOKEA: harvestedCount / fingerlingsCount = (SOLD + REMOVED) /
    # vifaranga, kikokotolewa na database (V19). HAKIPOKELEWI kama input
    # popote - hakuna mutation yenye uga wake, na Postgres yenyewe
    # inakataa kuiandika.
    actualSurvivalRate: Float

    # ACTIVE / HARVESTED / FAILED
    status: String!
}

input CreateCycleInput {
    unitId: ID!
    speciesId: ID!
    stockingDate: String!
    fingerlingsCount: Int!
    survivalRateEstimate: Float

    # Hiari: umri wa samaki (miezi) wakati wa kuwekwa. Ikiachwa wazi ni 0.
    # LAZIMA iwe chini ya umri wa kuvunwa wa aina husika
    # (species.growthMonthsAvg) - vinginevyo VALIDATION_ERROR.
    stockingAgeMonths: Int

    # Hiari: gharama ya vifaranga. Ikitolewa lazima iwe > 0
    # (VALIDATION_ERROR vinginevyo). NUMERIC(14,2).
    fingerlingCost: Float
}

# Tukio moja la samaki kutoka kwenye bwawa (V25).
type HarvestEvent {
    harvestEventId: ID!
    cycleId: Int!
    eventDate: String!
    fishCount: Int!
    # Null inawezekana kwa DIED/REMOVED pekee.
    weightKg: Float
    # SOLD / DIED / REMOVED
    reason: String!
    # Kwa SOLD pekee (null kwa nyingine). FEDHA: null bila `view_finance`.
    saleAmount: Float
}

# ============================================================
# Feed — katalogi ya chakula, ununuzi, ulishaji, na leja ya stoo
#
# `feedType` ilikuwa MAANDISHI HURU kwenye ununuzi na ulishaji. Sasa ni
# katalogi (angalia V16__feed_type_catalog.sql). Maandishi huru hayakuweza
# kujibu swali linaloamua kila mlo: chakula hiki ni cha samaki wa umri
# gani? - wala kuruhusu salio la stoo kuhesabiwa kwa aina.
# ============================================================

# Aina ya chakula. Ni katalogi YA KIMFUMO (haina farm_id), kama Species -
# mashamba yote yanaisoma ile ile.
type FeedType {
    feedTypeId: ID!
    name: String!
    # Dirisha la umri ambalo chakula hiki kimetengenezwa kwa ajili yake, kwa
    # miezi, PANDE ZOTE MBILI ZIKIHUSISHWA. Chakula cha vifaranga ni [0, 0].
    minAgeMonths: Int!
    maxAgeMonths: Int!
    # Aina isiyotumika tena inazimwa, haifutwi - rekodi za zamani
    # zinaielekea.
    active: Boolean!
}

# Mstari mmoja wa salio. Kilo za aina moja haziwezi kulisha samaki
# wanaohitaji nyingine, hivyo salio moja la shamba zima lilikuwa
# linadanganya: +50 ya chakula cha vifaranga na -50 cha wakubwa
# zilighairiana hadi 0, ghala lenye chakula likionekana tupu.
type FeedStockBalance {
    feedType: FeedType!
    # Inaweza kuwa HASI: leja inaripoti, haihukumu (angalia FeedService).
    quantityKg: Float!
}

# Athari ya kuzima aina moja, kwa shamba la mwombaji.
#
# ONYO, SI KIKWAZO. setFeedTypeActive inazima BILA KUULIZA namba hizi:
# kuzima kunarudishwa nyuma (`active: true` ni mutation ile ile), na aina
# inayoachwa kutumika mara nyingi ina kilo zilizobaki - hiyo ndiyo sababu
# ya kuzima, si sababu ya kukataliwa. Uamuzi ni wa mtu; kazi ya server ni
# kumpa namba kabla, si baada.
type FeedTypeDeactivationImpact {
    # Salio la aina HII ghalani mwa shamba la mwombaji (kg) - jumla ILE ILE
    # inayosomwa na `feedStockBalance` kwa mstari wake. Inaweza kuwa HASI
    # (leja inaripoti, haihukumu) na ni SIFURI - si null - kwa aina isiyo na
    # movement yoyote hapa.
    remainingKg: Float!

    # Mizunguko INAYOENDELEA ya shamba hili ambayo, kwa umri wao wa LEO,
    # aina hii ndiyo EXACT yao PEKEE - yaani ikizimwa hawabaki na chakula
    # kilichokusudiwa umri wao.
    #
    # Mzunguko wenye chaguo jingine - EXACT nyingine, AU SAFE_LOWER
    # (chakula cha wadogo, ambacho wakubwa wanakila) - HAUHESABIWI. Onyo
    # linalolia kwa mzunguko ambao bado una cha kula ni onyo ambalo mtu
    # atajifunza kulipuuza.
    dependentActiveCycleCount: Int!
}

# Aina pamoja na SABABU ya kuwa kwenye orodha ya kufaa.
type SuitableFeedType {
    feedType: FeedType!
    # EXACT      - min <= umri <= max; kilichokusudiwa umri huu.
    # SAFE_LOWER - max < umri; chakula cha wadogo, wakubwa wanakila.
    # UNSAFE_HIGHER HAIONEKANI HAPA KAMWE: chakula cha samaki wakubwa
    # kuliko hawa hakirudishwi kabisa, kwa sababu chochote kilicho kwenye
    # orodha ya kuchagua kitachaguliwa na mtu fulani siku fulani.
    suitability: String!
}

type FeedTypesForCycle {
    # Miezi mizima tangu kuwekwa kwa vifaranga, ikishushwa chini, si chini
    # ya sifuri. Inarudishwa ili mteja aeleze uamuzi bila kuukokotoa upya.
    cycleAgeMonths: Int!
    # true = KILA aina inayotumika ni ya samaki wakubwa kuliko hawa (au
    # katalogi ni tupu). Ni bendera yake yenyewe, si `feedTypes.isEmpty()`
    # inayokisiwa na mteja: orodha tupu hapa ni pengo halisi la katalogi
    # linalopaswa kuelezwa, si hali ya kawaida.
    noSuitableFeed: Boolean!
    # EXACT kwanza, kisha SAFE_LOWER; ndani ya kila daraja, kwa jina.
    feedTypes: [SuitableFeedType!]!
}

# Mstari wa manunuzi. Safu za UENDESHAJI (tarehe, aina, kiasi, muuzaji)
# zinaonekana kwa kila mwenye `view_dashboard`; safu za BEI zinahitaji
# ruhusa yake yenyewe - angalia V18__view_feed_cost_permission.sql.
type FeedPurchase {
    purchaseId: ID!
    purchaseDate: String!
    feedType: FeedType!
    quantityKg: Float!

    # NULL KWA MAKUSUDI kwa asiye na `view_feed_cost` - si "haijawekwa".
    # Ilikuwa `Float!`; imelegezwa kwa sababu moja: mstari uliofichwa bei
    # LAZIMA uweze kubeba null, na uga usio-null unaorudisha null
    # ungeangusha ORODHA NZIMA (graphql-java inapandisha null hadi kwenye
    # uga wa karibu unaoruhusu null). Ufichaji unafanywa na
    # FeedService.listPurchases - SI na UI. Safu iliyofichwa kwenye jedwali
    # la mteja ni namba iliyokwisha safiri kwenye waya.
    unitCost: Float

    # Inakokotolewa na database (GENERATED ALWAYS AS quantity_kg * unit_cost
    # STORED, V1) - si sehemu ya input, na haiandikwi na Hibernate. Ni null
    # pia kwa asiye na `view_feed_cost`: ingekuwa unitCost kwa kugawanya.
    totalCost: Float

    supplier: String

    # Umebatilishwa kwa rekodi ya kurekebisha. Safu inabaki - leja ni ya
    # kuongezwa tu - lakini kilo zake hazipo tena kwenye feedStockBalance.
    #
    # Inasomwa KUTOKA KWENYE LEJA (movement ya OUT inayouelekea), si kutoka
    # safu ya feed_purchases: safu kama hiyo ingekuwa nakala inayoweza
    # kuachana na ukweli. HAIFICHWI kwa asiye na `view_feed_cost` -
    # ubatilishaji si bei, na anayepanga kulisha anahitaji kujua kwamba
    # magunia haya hayako ghalani.
    reversed: Boolean!
}

input RecordFeedPurchaseInput {
    purchaseDate: String!
    feedTypeId: Int!
    quantityKg: Float!
    unitCost: Float!
    supplier: String
}

type FeedingLog {
    logId: ID!
    cycle: Cycle!
    logDate: String!
    # SI NULL tena (ilikuwa `String`). Ulishaji usiotaja chakula hauwezi
    # kupunguza salio la aina yoyote, hivyo ungeacha stoo ikidai kilo
    # ambazo samaki tayari wamekula.
    feedType: FeedType!
    quantityKg: Float!
    recordedByName: String
}

input LogFeedingInput {
    cycleId: Int!
    # Ikiachwa wazi, inatumia leo
    logDate: String
    # INAKAGULIWA dhidi ya umri wa mzunguko kwa sheria ile ile ya
    # feedTypesForCycle (FeedService.classify). Vinavyokataliwa kwa
    # VALIDATION_ERROR ni VIWILI TU: chakula cha samaki WAKUBWA kuliko hawa
    # (minAgeMonths > umri), na aina iliyozimwa.
    #
    # SAFE_LOWER INARUHUSIWA kwa makusudi: kulisha wakubwa chakula cha
    # wadogo ni uamuzi halali (stoo imeisha, mfuko wa mwisho), si kosa.
    # Onyo ni kazi ya UI, si la server kuzuia.
    feedTypeId: Int!
    quantityKg: Float!
}

# Leja inayozalishwa na mfumo: kununua -> IN, kulisha -> OUT.
# Haiandikwi moja kwa moja na mteja (angalia FeedService).
type FeedStockMovement {
    movementId: ID!
    feedType: FeedType!
    direction: String!
    quantityKg: Float!
    referencePurchaseId: Int
    referenceFeedingLogId: Int
    movedAt: String!
}

# ============================================================
# Water Quality — vipimo vya maji kwenye kitengo
#
# Kipimo ni cha KITENGO, si cha mzunguko (water_quality_logs.unit_id):
# maji ni mali ya tanki, si ya samaki walioko ndani yake msimu huu.
#
# Vipimo vyote vinne vinaweza kuwa null - mtu mwenye kipima-pH pekee
# anarekodi pH, na kuacha nyingine wazi ni sahihi zaidi kuliko sifuri.
#
# THAMANI MBAYA INAKUBALIWA. Oksijeni 0.8, pH 4.2, amonia 0.9 - hizi
# ndizo sababu ya kupima, na amonia ndiyo chanzo kikuu cha vifo vya
# ghafla. Kinachokataliwa ni kisichowezekana kimuundo pekee: pH nje ya
# 0-14, oksijeni au amonia hasi (angalia WaterQualityService).
# ============================================================

type WaterQualityLog {
    logId: ID!
    unit: ProductionUnit!
    logDate: String!
    # 0.0 - 14.0
    ph: Float
    # Nyuzi Selsiasi
    temperature: Float
    # Oksijeni iliyoyeyuka (DO), mg/L
    oxygen: Float
    # Amonia jumla (NH3 + NH4+), mg/L. Desimali mbili: 0.02 ni salama,
    # 0.25 inaua polepole.
    ammonia: Float
    notes: String
    recordedByName: String
}

input LogWaterQualityInput {
    unitId: Int!
    # Ikiachwa wazi, inatumia leo
    logDate: String
    ph: Float
    temperature: Float
    oxygen: Float
    ammonia: Float
    notes: String
}

# ============================================================
# Daily Tasks — kazi za kila siku na ukamilishaji wake
#
# `daily_tasks` ni KIOLEZO kinachojirudia (frequency=DAILY,
# scheduled_time ni saa ya siku, hakuna tarehe ya mwisho). Hivyo
# "imekamilika" si bendera juu ya kiolezo - ingekuwa kweli milele baada
# ya siku ya kwanza - bali ni REKODI ya `task_completions`, moja kwa
# (kiolezo, tarehe), kama UNIQUE(task_id, completion_date) ya V1
# inavyolazimisha.
#
# MKATABA WA REMINDERS, na ndiyo sababu type hii ipo:
#
#     done = kuna rekodi ya (task_id, tarehe) yenye status DONE
#
# Kila kitu kingine ni outstanding - ikiwemo rekodi ya PENDING/MISSED/
# LATE, kwa sababu kazi iliyokosekana bado ni kazi isiyofanyika.
# ============================================================

type DailyTaskStatus {
    taskId: ID!
    cycleId: Int
    # Tanki/bwawa (mfano "DEV-A1") na aina ya samaki (mfano "Sato").
    # Ni za farmDailyTasks hasa: kwenye orodha ya shamba zima
    # "Kulisha - Asubuhi" inajirudia mara moja kwa kila mzunguko, na
    # namba ya mzunguko si kitu mfanyakazi anachokijua - tanki ndicho.
    # Nullable: cycle_id ni nullable kwenye schema (angalia V1).
    unitCode: String
    speciesName: String
    # Kulisha - Asubuhi / Kulisha - Jioni / Kuangalia Maji
    taskType: String!
    # Saa ya siku (HH:mm). Inarudishwa ili mteja aweze kukokotoa
    # "overdue" (outstanding NA saa imepita) mwenyewe - haikokotolewi
    # hapa kwa sababu inahitaji kanda ya saa, uamuzi wa Reminders.
    scheduledTime: String!
    frequency: String!
    # Role iliyopangiwa kazi. NI null kwa data yote iliyopo:
    # CycleService.createDefaultTasks haiweki assigned_role_id.
    assignedRoleName: String
    # Tarehe iliyoulizwa (au leo)
    date: String!
    # DONE / PENDING / MISSED / LATE kama rekodi ipo; OUTSTANDING kama
    # haipo kabisa. Ina maelezo zaidi kuliko `done`.
    status: String!
    # Bendera moja isiyo na utata - ndiyo Reminders inayoisoma
    done: Boolean!
    completedAt: String
    completedByName: String
    notes: String
}

input CompleteTaskInput {
    taskId: Int!
    # Ikiachwa wazi, inatumia leo
    completionDate: String
    notes: String
}

# Module iliyobaki (Finance) itaongezwa hapa kwa muundo uleule -
# angalia SRS §8 kwa orodha kamili.
