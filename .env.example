# Nakili hii kuwa `.env` (haiingii kwenye git) kisha jaza thamani.
#
# `.env` inasomwa na app yenyewe (angalia spring.config.import kwenye
# application.yml), hivyo `mvn spring-boot:run` na kitufe cha Run cha IDE
# vinafanya kazi bila kuweka environment variables kwa mkono.
#
# Environment variables HALISI zina kipaumbele zaidi ya faili hii - ndivyo
# production inavyofanya kazi (hakuna `.env` huko kabisa).
#
# Kwa kupitisha thamani mara moja bila kugusa faili (PowerShell):
#   $env:DB_PASSWORD = "..."; $env:JWT_SECRET = "..."; mvn spring-boot:run

# ---------- Database (LAZIMA) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=samakiFarm
DB_USER=postgres
DB_PASSWORD=

# ---------- JWT (LAZIMA) ----------
# Herufi ndefu za nasibu - angalau 32. App HAITAANZA bila hii.
JWT_SECRET=

# ---------- ROOT superadmin ----------
# Bila hizi, ROOT hatengenezwi (app inaanza, lakini kwa onyo kwenye logs).
# Password hii ni ya MARA YA KWANZA TU - mfumo unamlazimisha aibadilishe.
ROOT_NAME=System Root
ROOT_PHONE=
ROOT_EMAIL=
ROOT_PASSWORD=

# DHARURA: ROOT amesahau password yake. Weka `true`, anzisha app upya mara
# MOJA - password yake inarudishwa kuwa ROOT_PASSWORD hapo juu na
# analazimika kuibadilisha akiingia. KISHA IONDOE mara moja: ikiachwa,
# kila restart itafuta password aliyoiweka mwenyewe.
# Bila hii, ROOT aliyepo haguswi kabisa wakati wa seeding.
ROOT_PASSWORD_RESET=false

# ---------- Vikumbusho (Reminders scheduler) ----------
# Zote zina default kwenye application.yml - hizi ni za kubadilisha bila
# kujenga upya. HAKUNA SMS/PUSH HALISI bado: providers ni stub
# zinazoandika kwenye logs (LoggingSmsSender / LoggingPushSender).
#
# false = tiki haifanyiki kabisa (bean ya scheduler haitengenezwi).
REMINDERS_ENABLED=true
# Saa 1 asubuhi / saa 6 mchana / saa 11 jioni, kwa kanda hapo chini.
REMINDERS_CRON=0 0 7,12,17 * * *
# Dodoma ni EAT (UTC+3). Server ya production kwa kawaida iko UTC.
REMINDERS_ZONE=Africa/Nairobi
# Saa za kimya (zinaruhusiwa kuvuka usiku wa manane). Zikiwa SAWA, zimezimwa.
REMINDERS_QUIET_START=21:00
REMINDERS_QUIET_END=06:00
# Kila njia peke yake. Mpokeaji mwenye simu NA push_token anapata zote mbili.
REMINDERS_SMS_ENABLED=true
REMINDERS_PUSH_ENABLED=true

# ---------- Nyingine ----------
PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---------- Zana za maendeleo ----------
# GraphiQL (console ya kutuma query) na schema printer ZIMEZIMWA kwa
# chaguo-msingi - zinafichua muundo wa API, hivyo production haipaswi
# kuzipata kwa bahati mbaya. Ziwashe kwa profile ya `dev`:
#
#     mvn spring-boot:run -Dspring-boot.run.profiles=dev
#
# HAIWEKWI hapa: spring.profiles.active haisomeki kwa uhakika kutoka
# faili inayoingizwa kwa spring.config.import (ndivyo `.env` inavyopakiwa).
# Tumia command line hapo juu, au environment variable halisi
# SPRING_PROFILES_ACTIVE=dev.
