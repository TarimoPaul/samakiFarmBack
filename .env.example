# Nakili hii kuwa `.env` (haiingii kwenye git) au weka thamani hizi kama
# environment variables za shell kabla ya `mvn spring-boot:run`.
#
# PowerShell:
#   $env:DB_PASSWORD = "..."; $env:JWT_SECRET = "..."; mvn spring-boot:run

# ---------- Database (LAZIMA) ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=samakiFarm
DB_USER=postgres
DB_PASSWORD=

# ---------- JWT (LAZIMA) ----------
# Herufi ndefu za nasibu - angalau 32. App HAITAANZA bila hii.
JWT_SECRET=

# ---------- ROOT superadmin ----------
# Bila hizi, ROOT hatengenezwi (app inaanza, lakini kwa onyo kwenye logs).
# Password hii ni ya MARA YA KWANZA TU - mfumo unamlazimisha aibadilishe.
ROOT_NAME=System Root
ROOT_PHONE=
ROOT_EMAIL=
ROOT_PASSWORD=

# ---------- Nyingine ----------
PORT=8082
CORS_ALLOWED_ORIGINS=http://localhost:4200
